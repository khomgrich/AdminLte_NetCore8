<script>
    // เพิ่ม Logic ใน script เดิมเพื่อเปลี่ยนสี Sidebar
    function updateSidebar(mode) {
        if(mode === 'dark') {
            $('#mainSidebar').removeClass('sidebar-light-primary').addClass('sidebar-dark-primary');
        } else {
            $('#mainSidebar').removeClass('sidebar-dark-primary').addClass('sidebar-light-primary');
        }
    }
</script>